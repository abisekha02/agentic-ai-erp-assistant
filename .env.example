# Copy to .env (repo root) and fill in
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=postgres://eka:eka@localhost:5432/eka
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
FRONTEND_ORIGIN=http://localhost:5173
# Set to 1 to run without an API key (hashed embeddings + rule-based router; for UI exploration/tests only)
FAKE_AI=0
