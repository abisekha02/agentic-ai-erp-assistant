# Copy to .env (repo root) and fill in
# --- Option 1: OpenAI (paid) ---
OPENAI_API_KEY=sk-...
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Option 2: Google Gemini free tier (key from https://aistudio.google.com) ---
# OPENAI_API_KEY=<your Gemini key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-2.5-flash          # use any free model listed in AI Studio
# EMBEDDING_MODEL=gemini-embedding-001
DATABASE_URL=postgres://eka:eka@localhost:5432/eka
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
FRONTEND_ORIGIN=http://localhost:5173
# Set to 1 to run without an API key (hashed embeddings + rule-based router; for UI exploration/tests only)
FAKE_AI=0
